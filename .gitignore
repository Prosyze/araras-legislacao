# Segredos — nunca versionar
.env
.env.local

# PDFs originais do Diário Oficial (~6,9 GB; baixados sob demanda)
diarios_oficiais/

# Bancos. O que vai versionado é só db/semente.db (acervo + índice de busca,
# gerado por scripts/gerar_semente.py). O banco de trabalho carrega também os
# chunks e vetores do RAG, que o servidor refaz sozinho e dobrariam o tamanho
# do repositório a cada reindexação.
db/araras_legislacao.db
db/backup_*.db
db/*.db-wal
db/*.db-shm
db/build_log.txt
*.part

# JSON original de origem (substituído pela API oficial)
diario-oficial-*.json

# Execução local
server.log
scripts/indexacao_local.log
__pycache__/
*.pyc
scratch_*
_*.txt
_*.json

# Lixo de execucao a partir de scripts/ (caminhos relativos errados)
scripts/db/
pdfs/
