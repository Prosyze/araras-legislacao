# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=coloque_sua_chave_aqui

# Opcional: chaves de reserva. A quota do free tier e por chave, entao
# quando a principal se esgota (429) o pedido e refeito na hora com a
# proxima, sem espera. A busca para no primeiro numero que faltar.
# GEMINI_API_KEY_FALLBACK_1=chave_de_reserva
# GEMINI_API_KEY_FALLBACK_2=outra_chave_de_reserva

# Opcional: modelo usado para os resumos
# GEMINI_MODEL=gemini-2.5-flash

# Opcional (Railway): diretorio do volume persistente.
# Quando definido, o banco e os PDFs passam a viver nele.
# DATA_DIR=/data
