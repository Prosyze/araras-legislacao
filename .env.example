# Copie para .env e preencha:  cp .env.example .env
# O .env nunca vai para o Git.

# ------------------------------------------------------------------ obrigatorio
# Chave do Google Gemini (https://aistudio.google.com/apikey).
# Sem ela a busca textual funciona, mas resumos e consulta por IA nao.
GEMINI_API_KEY=coloque_sua_chave_aqui

# ------------------------------------------------------------------ recomendado
# Mantem o banco exatamente como veio no repositorio (sem sincronizar com a
# semente nem sanitizar na subida). Use 1 ao rodar com db/araras_legislacao.db.
LOCAL_PRESERVE_DB=1

# ------------------------------------------------------------------ opcional
# Chaves de reserva: quota estourada (429) troca de chave na hora.
# A busca para no primeiro numero que faltar.
# GEMINI_API_KEY_FALLBACK_1=
# GEMINI_API_KEY_FALLBACK_2=
# GEMINI_API_KEY_FALLBACK_3=

# Modelos (padrao: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
# RAG_CHAT_MODEL=gemini-flash-latest

# Embeddings da busca semantica. O banco versionado foi indexado com
# gemini / gemini-embedding-001 (768 dim): trocar isso obriga a reindexar.
RAG_EMBED_BACKEND=gemini
# RAG_EMBED_MODEL=gemini-embedding-001

# Caminhos. Sem DATA_DIR o app usa db/araras_legislacao.db e diarios_oficiais/
# dentro do repositorio. No Railway, aponte DATA_DIR para o volume (/data).
# DATA_DIR=/data
# DB_PATH=db/araras_legislacao.db
# PDF_DIR=diarios_oficiais

# Token para rotas administrativas da IA e salt do log de consultas.
# ADMIN_TOKEN=
# LOG_SALT=
